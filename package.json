{
  "name": "physics-exam-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Physics Exam Pro — Telegram bot, Mini App va admin panel (1-bosqich)",
  "engines": { "node": ">=20.11" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev -w @pep/api",
    "dev:bot": "npm run dev -w @pep/bot",
    "dev:student": "npm run dev -w @pep/student-app",
    "dev:admin": "npm run dev -w @pep/admin-web",
    "build": "npm run build -w @pep/shared && npm run build -w @pep/api && npm run build -w @pep/bot && npm run build -w @pep/student-app && npm run build -w @pep/admin-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:sql": "node tests/sql/run.mjs",
    "db:migrate": "npm run db:migrate -w @pep/api",
    "db:seed": "npm run db:seed -w @pep/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.0"
  }
}
